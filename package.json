{
  "name": "ai-data-cleanup-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "eval": "tsx evals/run.ts",
    "eval:recorded": "tsx evals/run.ts recorded",
    "eval:live": "tsx --env-file-if-exists=.env.local evals/run.ts live",
    "eval:heldout": "tsx --env-file-if-exists=.env.local evals/run.ts heldout"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "next": "16.4.6",
    "papaparse": "^5.7.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
